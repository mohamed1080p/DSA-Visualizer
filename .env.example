ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=.;Database=DSA-VisualizerDB;Trusted_Connection=true;TrustServerCertificate=true
# Minimum 32 characters. Local dev: copy vars here or use `dotnet user-secrets set "JwtSettings:SecretKey" "..." --project DSA-Visualizer`
JwtSettings__SecretKey=replace-with-a-long-random-secret-at-least-32-chars
JwtSettings__Issuer=DSA-Visualizer
JwtSettings__Audience=DSA-Visualizer
JwtSettings__ExpiryInMinutes=30
JwtSettings__RefreshTokenExpiryInDays=7
ExternalAuth__Google__ClientId=replace-with-google-client-id
ExternalAuth__Google__ClientSecret=replace-with-google-client-secret
ExternalAuth__GitHub__ClientId=replace-with-github-client-id
ExternalAuth__GitHub__ClientSecret=replace-with-github-client-secret
Hangfire__Dashboard__Users__0__Login=replace-with-dashboard-login
Hangfire__Dashboard__Users__0__PasswordClear=replace-with-dashboard-password
Hangfire__Dashboard__EnableInNonDevelopment=false
Ollama__RequestTimeoutSeconds=120

# Production: set explicit hosts (not *) and real browser origins, e.g.:
# AllowedHosts=api.example.com
# Cors__Origins__0=https://app.example.com

# Vite client (create client/.env.local or set at build time)
# VITE_API_BASE_URL=http://localhost:5258/api
# VITE_API_ORIGIN=http://localhost:5258