{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DSA_Visualizer_DB;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "__SET_VIA_ENV__",
    "Issuer": "DSA-Visualizer",
    "Audience": "DSA-Visualizer",
    "ExpiryInMinutes": "30",
    "RefreshTokenExpiryInDays": "7"
  },
  "Judge0": {
    "BaseUrl": "http://localhost:2358"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "neural-chat:latest",
    "SystemPrompt": "You are DSA Visualizer's learning assistant. Help the user with data structures, algorithms, complexity analysis, coding interview prep, and the topics shown in this app. Keep answers clear, concise, and practical."
  },
  "ExternalAuth": {
    "Google": {
      "ClientId": "__SET_VIA_ENV__",
      "ClientSecret": "__SET_VIA_ENV__"
    },
    "GitHub": {
      "ClientId": "__SET_VIA_ENV__",
      "ClientSecret": "__SET_VIA_ENV__"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "Submissions": {
      "TokenLimit": 5,
      "TokensPerPeriodReplenishment": 1,
      "ReplenishmentPeriodSeconds": 15,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "General": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Hangfire": {
    "Dashboard": {
      "EnableInNonDevelopment": false,
      "Users": [
        {
          "Login": "__SET_VIA_ENV__",
          "PasswordClear": "__SET_VIA_ENV__"
        }
      ]
    }
  }
}